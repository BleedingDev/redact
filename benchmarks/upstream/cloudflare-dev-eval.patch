diff --git a/packages/vite-plugin-cloudflare/src/workers/runner-worker/eval-binding.ts b/packages/vite-plugin-cloudflare/src/workers/runner-worker/eval-binding.ts
new file mode 100644
--- /dev/null
+++ b/packages/vite-plugin-cloudflare/src/workers/runner-worker/eval-binding.ts
@@ -0,0 +1,10 @@
+/**
+ * Provide indirect eval for development stack reconstruction in the module runner.
+ * @param evaluate - The runner's existing local code evaluation binding.
+ */
+export function installIndirectEval(
+	evaluate: (source: string) => unknown
+): void {
+	globalThis.eval = (source) =>
+		typeof source === "string" ? evaluate(source) : source;
+}
diff --git a/packages/vite-plugin-cloudflare/src/workers/runner-worker/__tests__/eval-binding.spec.ts b/packages/vite-plugin-cloudflare/src/workers/runner-worker/__tests__/eval-binding.spec.ts
new file mode 100644
--- /dev/null
+++ b/packages/vite-plugin-cloudflare/src/workers/runner-worker/__tests__/eval-binding.spec.ts
@@ -0,0 +1,52 @@
+import { test } from "vitest";
+import { installIndirectEval } from "../eval-binding";
+
+test("delegates strings to the local development evaluator", ({ expect }) => {
+	const original = globalThis.eval;
+	const calls: string[] = [];
+	try {
+		installIndirectEval((source) => {
+			calls.push(source);
+			return original(source);
+		});
+		expect(globalThis.eval("40 + 2")).toBe(42);
+		expect(globalThis.eval("(function FlightStack() {})").name).toBe(
+			"FlightStack"
+		);
+		expect(calls).toEqual(["40 + 2", "(function FlightStack() {})"]);
+	} finally {
+		globalThis.eval = original;
+	}
+});
+
+test("returns non-string inputs unchanged without evaluating them", ({
+	expect,
+}) => {
+	const original = globalThis.eval;
+	let calls = 0;
+	try {
+		installIndirectEval(() => {
+			calls++;
+		});
+		const evaluate = globalThis.eval as (value: unknown) => unknown;
+		for (const value of [undefined, null, 1, true, {}, new String("40 + 2")]) {
+			expect(evaluate(value)).toBe(value);
+		}
+		expect(calls).toBe(0);
+	} finally {
+		globalThis.eval = original;
+	}
+});
+
+test("preserves syntax and runtime errors from the evaluator", ({ expect }) => {
+	const original = globalThis.eval;
+	try {
+		installIndirectEval((source) => original(source));
+		expect(() => globalThis.eval("(")).toThrow(SyntaxError);
+		expect(() =>
+			globalThis.eval('throw new Error("development error")')
+		).toThrow("development error");
+	} finally {
+		globalThis.eval = original;
+	}
+});
