diff --git a/packages/next/src/server/route-modules/pages/pages-handler.ts b/packages/next/src/server/route-modules/pages/pages-handler.ts
index c4d5f36e..52afbd60 100644
--- a/packages/next/src/server/route-modules/pages/pages-handler.ts
+++ b/packages/next/src/server/route-modules/pages/pages-handler.ts
@@ -706,7 +706,7 @@ export const getHandler = ({
 
         // In dev, we should not cache pages for any reason.
         if (routeModule.isDev) {
-          res.setHeader('Cache-Control', 'no-cache, must-revalidate')
+          res.setHeader('Cache-Control', 'no-store')
         }
 
         // Draft mode should never be cached
diff --git a/test/development/dev-cache-control-no-cache/app/streaming/counter.tsx b/test/development/dev-cache-control-no-cache/app/streaming/counter.tsx
new file mode 100644
index 00000000..62454fb3
--- /dev/null
+++ b/test/development/dev-cache-control-no-cache/app/streaming/counter.tsx
@@ -0,0 +1,15 @@
+'use client'
+
+import { useState } from 'react'
+
+export default function Counter() {
+  const [count, setCount] = useState(0)
+  return (
+    <>
+      <p id="count">Count: {count}</p>
+      <button id="increment" onClick={() => setCount((value) => value + 1)}>
+        Increment
+      </button>
+    </>
+  )
+}
diff --git a/test/development/dev-cache-control-no-cache/app/streaming/page.tsx b/test/development/dev-cache-control-no-cache/app/streaming/page.tsx
new file mode 100644
index 00000000..912171f7
--- /dev/null
+++ b/test/development/dev-cache-control-no-cache/app/streaming/page.tsx
@@ -0,0 +1,18 @@
+import { Suspense } from 'react'
+import Counter from './counter'
+
+async function Content() {
+  await new Promise((resolve) => setTimeout(resolve, 1000))
+  return <p id="streamed">Stream complete</p>
+}
+
+export default function Page() {
+  return (
+    <>
+      <Counter />
+      <Suspense fallback={<p>Loading stream</p>}>
+        <Content />
+      </Suspense>
+    </>
+  )
+}
diff --git a/test/development/dev-cache-control-no-cache/dev-cache-control-no-cache.test.ts b/test/development/dev-cache-control-no-cache/dev-cache-control-no-cache.test.ts
index 2a38178d..a58f39ac 100644
--- a/test/development/dev-cache-control-no-cache/dev-cache-control-no-cache.test.ts
+++ b/test/development/dev-cache-control-no-cache/dev-cache-control-no-cache.test.ts
@@ -1,17 +1,66 @@
 import { nextTestSetup } from 'e2e-utils'
+import { retry } from 'next-test-utils'
 
 describe('dev Cache-Control header', () => {
   const { next } = nextTestSetup({
     files: __dirname,
   })
 
-  it('should use no-cache for pages router', async () => {
+  it('should use no-store for pages router', async () => {
     const res = await next.fetch('/pages-route')
-    expect(res.headers.get('Cache-Control')).toBe('no-cache, must-revalidate')
+    expect(res.headers.get('Cache-Control')).toBe('no-store')
   })
 
-  it('should use no-cache for app router', async () => {
+  it('should use no-store for app router', async () => {
     const res = await next.fetch('/app-route')
-    expect(res.headers.get('Cache-Control')).toBe('no-cache, must-revalidate')
+    expect(res.headers.get('Cache-Control')).toBe('no-store')
+  })
+
+  it('should still revalidate unchanged static assets', async () => {
+    const $ = await next.render$('/app-route')
+    const asset = $('script[src]')
+      .map((_, element) => $(element).attr('src'))
+      .get()
+      .find((src) => src.startsWith('/_next/static/'))
+    expect(asset).toBeDefined()
+
+    const response = await next.fetch(asset)
+    expect(response.status).toBe(200)
+    expect(response.headers.get('Cache-Control')).toBe(
+      'no-cache, must-revalidate'
+    )
+    const etag = response.headers.get('ETag')
+    expect(etag).toBeTruthy()
+
+    const cached = await next.fetch(asset, {
+      headers: { 'If-None-Match': etag },
+    })
+    expect(cached.status).toBe(304)
+  })
+
+  it('should finish a streamed document without reloading it', async () => {
+    let navigations = 0
+    const browser = await next.browser('/streaming', {
+      beforePageLoad(page) {
+        page.on('request', (request) => {
+          if (
+            request.isNavigationRequest() &&
+            request.url().endsWith('/streaming')
+          ) {
+            navigations++
+          }
+        })
+      },
+    })
+    await retry(async () => {
+      expect(await browser.elementById('streamed').text()).toBe(
+        'Stream complete'
+      )
+    })
+    await browser.elementById('increment').click()
+    await retry(async () => {
+      expect(await browser.elementById('count').text()).toBe('Count: 1')
+    })
+    expect(navigations).toBe(1)
   })
 })
