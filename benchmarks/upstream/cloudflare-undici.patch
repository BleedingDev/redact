From 6bdcfb3bcd72178c42d5724379a9dc6d5d4db993 Mon Sep 17 00:00:00 2001
From: Tanner Linsley <tannerlinsley@gmail.com>
Date: Sun, 25 Oct 2026 02:04:51 -0600
Subject: [PATCH] fix(deps): update Undici to prevent response stream crashes

---
 .changeset/fix-undici-content-encoding.md  |  13 ++
 packages/miniflare/test/http/fetch.spec.ts |  42 +++++++
 pnpm-lock.yaml                             | 133 +++++++++++----------
 pnpm-workspace.yaml                        |   4 +-
 4 files changed, 127 insertions(+), 65 deletions(-)
 create mode 100644 .changeset/fix-undici-content-encoding.md

diff --git a/.changeset/fix-undici-content-encoding.md b/.changeset/fix-undici-content-encoding.md
new file mode 100644
index 0000000..d72f3b4
--- /dev/null
+++ b/.changeset/fix-undici-content-encoding.md
@@ -0,0 +1,13 @@
+---
+"miniflare": patch
+"@cloudflare/deploy-helpers": patch
+"@cloudflare/workers-auth": patch
+"@cloudflare/workers-utils": patch
+"create-cloudflare": patch
+"@cloudflare/vitest-plugin": patch
+"wrangler": patch
+---
+
+Update Undici to 7.30.1 to prevent a malformed HTTP response from crashing development tools
+
+The updated shared dependency rejects excessive content encodings without leaving an unhandled stream error when the server closes the connection early. This fixes GHSA-xjj6-f33q-929c and keeps the matching Undici types on the same version.
diff --git a/packages/miniflare/test/http/fetch.spec.ts b/packages/miniflare/test/http/fetch.spec.ts
index a8051bc..d8b7939 100644
--- a/packages/miniflare/test/http/fetch.spec.ts
+++ b/packages/miniflare/test/http/fetch.spec.ts
@@ -1,6 +1,8 @@
 import { Blob } from "node:buffer";
+import { execFile } from "node:child_process";
 import http from "node:http";
 import { URLSearchParams } from "node:url";
+import { promisify } from "node:util";
 import {
 	DeferredPromise,
 	DispatchFetchDispatcher,
@@ -21,6 +23,46 @@ test("fetch: performs regular http request", async ({ expect }) => {
 	const res = await fetch(upstream);
 	expect(await res.text()).toBe("upstream");
 });
+test("fetch: rejects excessive content encodings without crashing the process", async ({
+	expect,
+}) => {
+	const upstream = (
+		await useServer((_req, res) => {
+			res.writeHead(200, {
+				"content-encoding": "gzip, gzip, gzip, gzip, gzip, gzip",
+				"content-length": "1",
+			});
+			res.flushHeaders();
+			res.socket?.end();
+		})
+	).http;
+
+	// An orphaned response stream used to emit an unhandled error after fetch
+	// rejected. Run in a child so that the regression must preserve process exit.
+	const result = await promisify(execFile)(
+		process.execPath,
+		[
+			"--input-type=module",
+			"-e",
+			`
+import assert from "node:assert/strict";
+import { setTimeout } from "node:timers/promises";
+const { fetch } = await import(process.argv[2]);
+await assert.rejects(fetch(process.argv[1]), (error) => {
+  assert.match(error.cause?.message ?? "", /too many content-encodings/);
+  return true;
+});
+await setTimeout(100);
+console.log("fetch rejected safely");
+`,
+			upstream.href,
+			new URL("../../dist/src/index.js", import.meta.url).href,
+		],
+		{ timeout: 10_000 }
+	);
+	expect(result.stdout.trim()).toBe("fetch rejected safely");
+	expect(result.stderr).toBe("");
+});
 test("fetch: performs http request with form data", async ({ expect }) => {
 	const echoUpstream = (
 		await useServer((req, res) => {
